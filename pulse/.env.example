# Environment example for Haver — Pulse

# PostgreSQL (recommended for production)
# Replace USER, PASSWORD, HOST, PORT and DBNAME accordingly.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# JWT secret used to sign authentication tokens (change to a strong value)
JWT_SECRET=replace_this_with_a_strong_secret

# NODE_ENV (development/production)
NODE_ENV=production
