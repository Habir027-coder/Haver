# Environment example for Haver — Pulse (production)

# PostgreSQL production connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# JWT secret used to sign authentication tokens (change to a strong value)
JWT_SECRET=replace_this_with_a_strong_secret

# NODE_ENV
NODE_ENV=production

# Vercel deployment (optional)
# If you use the Vercel Git integration you don't need these. If using the Vercel CLI in CI, provide VERCEL_TOKEN, VERCEL_ORG_ID and VERCEL_PROJECT_ID as repository secrets.
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_vercel_org_id
# VERCEL_PROJECT_ID=your_vercel_project_id
